# Public production URL used for canonical links and sitemap generation.
VITE_SITE_URL=https://vergeform.netlify.app

# Same-site API route used by the contact form.
VITE_ENQUIRY_ENDPOINT=/api/enquiry

# Optional measurement. Analytics loads only after visitor consent.
VITE_GA_MEASUREMENT_ID=

# Optional Google Search Console HTML-tag verification value.
VITE_GOOGLE_SITE_VERIFICATION=

# Public business details. Completed values appear in contact, footer, and schema.
VITE_PUBLIC_EMAIL=
VITE_PUBLIC_WHATSAPP=
VITE_PUBLIC_LOCATION=
VITE_BOOKING_URL=
VITE_LINKEDIN_URL=
VITE_INSTAGRAM_URL=

# Server-only Power Automate HTTP trigger URL. Configure this in your hosting
# provider's environment settings—never expose it with a VITE_ prefix.
EXCEL_WEBHOOK_URL=
